// Data structs filled by src/panels/bridge.rs from the plain-Rust view models.
// The .slint panels only lay out these values; every string is decided in Rust.
// The kit structs are re-exported so the bridge builds them from this compile
// unit (generated Slint structs are per compile unit).
import { DayBar, HoverCardData, BarSegment } from "../components/kit.slint";
export { DayBar, BarSegment, CategoryItem, MetricItem, LabelValue, HoverCardData } from "../components/kit.slint";

/// One placed legend chip of the Usage Breakdown card (`kit::breakdown`).
export struct BreakdownChipData {
    name: string,
    value: string,
    color: color,
    x: length,
    y: length,
}

/// The Usage Breakdown card: the bar, then the placed legend chips.
export struct BreakdownData {
    present: bool,
    segments: [BarSegment],
    chips: [BreakdownChipData],
    chips-height: length,
}

export struct TrackData {
    label: string,
    show-label: bool,
    /// 0...100.
    percent: float,
    color: color,
    caption: string,
    caption-warning: bool,
}

export struct ModelRowData {
    name: string,
    cost: string,
    tag: string,
    share: float,
    color: color,
    /// Floating label while the row is hovered (empty title: none).
    hover: HoverCardData,
}

export struct ModelsData {
    present: bool,
    title: string,
    collapsible: bool,
    expanded: bool,
    toggle: string,
    /// "This PC" for local figures; empty draws no tag.
    source-tag: string,
    /// The header as a screen reader says it, with the location when local.
    spoken-title: string,
    rows: [ModelRowData],
}

export struct DailyData {
    present: bool,
    title: string,
    allowance: string,
    range: string,
    has-nav: bool,
    can-next: bool,
    accent: color,
    bars: [DayBar],
    footer: string,
}

export struct FooterData {
    stale-message: string,
    stale-age: string,
    sign-in-again: string,
    error-text: string,
    sign-out-confirm: string,
    /// "Resets available" pill beside the sign-out control; empty hides it.
    pill-label: string,
    pill-value: string,
    pill-help: string,
    pill-tint: color,
}

export struct HeaderData {
    /// `ProviderId::logo_asset_key()`.
    logo-key: string,
    title: string,
    meta: string,
    accent: color,
}

export struct HourSegData {
    height: length,
    color: color,
}

export struct HourBarData {
    bar-height: length,
    segments: [HourSegData],
    axis-label: string,
    tooltip: string,
}

export struct LegendData {
    title: string,
    color: color,
}

export struct OverviewCardData {
    logo-key: string,
    title: string,
    meta: string,
    used-text: string,
    percent: float,
    color: color,
    caption: string,
    caption-tertiary: bool,
    sign-in: string,
    has-sign-out: bool,
}

export struct TabData {
    label: string,
    logo-key: string,
    selected: bool,
    present: bool,
    divider: bool,
}

export struct TabRowData {
    top-divider: bool,
    cells: [TabData],
}
